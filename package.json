{
  "name": "online-learning-platform",
  "version": "1.0.0",
  "description": "Online Learning Platform with a Modern User Interface",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "setup": "node db/setup.js",
    "dev": "node --watch server.js",
