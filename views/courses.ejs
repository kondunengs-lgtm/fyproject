<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <h1>Courses</h1>
        <p class="muted"><%= courses.length %> course<%= courses.length === 1 ? '' : 's' %> available</p>
      </div>
    </div>

    <form class="filters" method="get" action="/courses">
      <input class="input" type="search" name="q" value="<%= search %>" placeholder="Search course titles" aria-label="Search courses" maxlength="100">
      <select name="category" aria-label="Filter by category">
        <option value="">All categories</option>
        <% categories.forEach(function (c) { %>
          <option value="<%= c.category %>" <%= category === c.category ? 'selected' : '' %>><%= c.category %></option>
        <% }); %>
      </select>
      <button class="btn" type="submit">Search</button>
    </form>

    <% if (courses.length === 0) { %>
      <div class="card empty">
        <h3>No course matches that search</h3>
        <p class="muted">Try a different word, or clear the filter to see everything.</p>
        <a class="btn btn-ghost btn-sm" href="/courses">Clear search</a>
      </div>
    <% } else { %>
      <div class="grid">
        <% courses.forEach(function (course) { %>
          <%- include('partials/course-card', { course: course, enrolled: enrolled }) %>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
