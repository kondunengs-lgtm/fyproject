<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section">
  <div class="container">
    <p class="muted" style="margin-bottom:8px"><a href="/instructor/courses">My courses</a></p>

    <div class="section-head">
      <div>
        <h1><%= course.title %></h1>
        <p class="muted"><%= course.category %> &middot; <%= modules.length %> module<%= modules.length === 1 ? '' : 's' %></p>
      </div>
      <div style="display:flex;gap:8px">
        <a class="btn btn-ghost btn-sm" href="/courses/<%= course.course_id %>">Preview</a>
        <a class="btn btn-ghost btn-sm" href="/instructor/courses/<%= course.course_id %>/edit">Edit details</a>
      </div>
    </div>

    <div class="card" style="margin-bottom:24px">
      <h3>Add a module</h3>
      <form method="post" action="/instructor/courses/<%= course.course_id %>/modules"
            style="display:flex;gap:8px;flex-wrap:wrap">
        <input class="input" name="title" required minlength="3" placeholder="Module title" style="flex:1;min-width:220px">
        <button class="btn" type="submit">Add module</button>
      </form>
    </div>

    <% if (modules.length === 0) { %>
      <div class="card empty">
        <h3>No modules yet</h3>
        <p class="muted">A course holds modules, and each module holds lessons. Add your first module above.</p>
      </div>
    <% } %>

    <% modules.forEach(function (mod) { %>
      <div class="panel" style="margin-bottom:16px">
        <div class="module-head" style="padding:16px">
          <span><%= mod.position %>. <%= mod.title %> &middot; <%= mod.lessons.length %> lesson<%= mod.lessons.length === 1 ? '' : 's' %></span>
          <form method="post" action="/instructor/modules/<%= mod.module_id %>/delete" style="margin:0"
                onsubmit="return confirm('Delete this module and its lessons?')">
            <button class="btn btn-sm btn-danger" type="submit">Delete module</button>
          </form>
        </div>

        <% mod.lessons.forEach(function (lesson) { %>
          <div class="lesson-link" style="justify-content:space-between;align-items:center">
            <span><%= lesson.position %>. <%= lesson.title %>
              <span class="muted">&middot; <%= Math.round(lesson.duration_seconds / 60) %> min</span>
            </span>
            <form method="post" action="/instructor/lessons/<%= lesson.lesson_id %>/delete" style="margin:0">
              <button class="btn btn-sm btn-danger" type="submit">Remove</button>
            </form>
          </div>
        <% }); %>

        <div style="padding:16px;border-top:1px solid var(--line);background:var(--surface-2)">
          <form method="post" action="/instructor/modules/<%= mod.module_id %>/lessons"
                enctype="multipart/form-data" style="display:grid;gap:8px">
            <input class="input" name="title" required minlength="3" placeholder="Lesson title">
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <input class="input" name="duration_seconds" type="number" min="0" placeholder="Length in seconds" style="flex:1;min-width:140px">
              <input class="input" name="video" type="file" accept="video/mp4" style="flex:2;min-width:200px">
            </div>
            <p class="hint">MP4 only, under 200 MB. Leave the file empty to use the sample video.</p>
            <button class="btn btn-sm" type="submit" style="justify-self:start">Add lesson</button>
          </form>
        </div>
      </div>
    <% }); %>
  </div>
</section>

<%- include('../partials/footer') %>
